{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automaty.bet/slownik-kasynowy/schema.json",
  "title": "Casino Glossary PL",
  "description": "JSON Schema for the Polish casino terminology glossary maintained by Automaty.bet.",
  "type": "object",
  "required": ["version", "language", "categories", "terms"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the glossary dataset."
    },
    "language": {
      "type": "string",
      "enum": ["pl"],
      "description": "ISO 639-1 language code. Only Polish is supported in this dataset."
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "maintainer": {
      "type": "string"
    },
    "maintainerUrl": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "lastUpdate": {
      "type": "string",
      "format": "date"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "authors": {
      "type": "array",
      "items": { "$ref": "#/$defs/author" }
    },
    "terms": {
      "type": "array",
      "items": { "$ref": "#/$defs/term" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "profileUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "term": {
      "type": "object",
      "required": ["id", "name", "category", "author", "sourceUrl"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Kebab-case slug used as the deep-link anchor."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "alternativeNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Must match an id from the categories array."
        },
        "author": {
          "type": "string",
          "description": "Must match a name from the authors array."
        },
        "shortDef": {
          "type": "string",
          "description": "One-sentence definition. May be empty in skeleton phase."
        },
        "fullDef": {
          "type": "string",
          "description": "Full multi-paragraph definition. May be empty in skeleton phase."
        },
        "example": {
          "type": "string",
          "description": "Concrete example illustrating the term. May be empty."
        },
        "relatedTerms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "List of related term ids."
        },
        "relatedUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "lastUpdate": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    }
  }
}
